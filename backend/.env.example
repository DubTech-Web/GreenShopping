# Copy to `.env` and set real values for any non-local deployment (Spec §25, Phase-2 §33).
# NEVER commit a filled-in .env — only this example. Secrets stay on the backend host.

# --- Environment ---
APP_ENV=development                       # set to "production" on Render

# --- Auth ---
# Generate a long random value (32+ bytes) in production, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-insecure-secret-change-me

# --- Database ---
# Local dev: SQLite file. Production: a managed PostgreSQL URL from Neon/Supabase/Render, e.g.
#   DATABASE_URL=postgresql://user:pass@host/dbname
# (a bare postgres:// / postgresql:// URL is auto-upgraded to the psycopg driver).
DATABASE_URL=sqlite:///./greenshopping.db

# --- Deployment URLs (used for CORS + Paystack callback) ---
FRONTEND_URL=                             # e.g. https://greenshopping.vercel.app
BACKEND_URL=                              # e.g. https://greenshopping-api.onrender.com

# --- Email verification & order receipts ---
# EMAIL_PROVIDER selects the preferred provider. When omitted, development prefers SMTP and
# production prefers Brevo. The other configured provider is used as a fallback after a
# definite delivery rejection/failure.
#
# LOCAL DEVELOPMENT: Gmail SMTP with an App Password.
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password (Google Account -> Security -> App passwords) and use it below.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=GreenShopping <your.address@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# PRODUCTION: Set APP_ENV=production and EMAIL_PROVIDER=brevo in Render.
# Create the API key in Brevo SMTP & API > API Keys. The sender email must be verified in Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=your.verified.sender@example.com
BREVO_FROM_NAME=GreenShopping

# --- Paystack payments ---
# Leave PAYSTACK_SECRET_KEY empty in dev: payment runs in simulation mode (no real charge).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# The demo charge is ALWAYS ₦100 = 10000 kobo. This is the actual amount charged, and is
# deliberately independent of the (realistic Naira) product/cart total (Spec Phase-2 §10, §32).
PAYMENT_AMOUNT_KOBO=10000
